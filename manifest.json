{
    "manifest_version": 3,
    "name": "Cookie Editor & Storage Manager",
    "description": "Manage cookies, localStorage, and sessionStorage from a Chrome side panel with search, bulk delete, and JSON import/export.",
    "version": "1.1.0",
    "permissions": [
        "cookies",
        "storage",
        "sidePanel",
        "tabs",
        "scripting"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "action": {
        "default_title": "Open Cookie Editor & Storage Manager"
    }
}